<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      REQUIRED on Android 11+ (API 30). Without this, bindService() and
      getPackageInfo() against de.blinkt.openvpn fail SILENTLY: the package is
      simply invisible to us. This is the single most likely cause of a
      "nothing happens when I tap connect" bug. Do not remove.
    -->
    <queries>
        <package android:name="de.blinkt.openvpn" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.VpnGateClient">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VpnGateClient">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
