<?xml version="1.0" encoding="utf-8"?>
<!-- Applies from API 31. Same exclusions as backup_rules.xml; see the comments there. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="servers.csv" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="servers.csv" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
